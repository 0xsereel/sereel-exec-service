# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
STABLECOIN_MINT=                     # mock USDC; created by `sereel init` if empty
MINT_AUTHORITY_KEYPAIR=./keys/mint_authority.json
FUNDING_KEYPAIR=./keys/funding.json  # receives strategy funding, pays withdrawals/refunds
ATTEST_KEYPAIR=./keys/attest.json    # posts memo attestations
PAYMENT_SOURCE_KEYPAIR=./keys/payment_source.json  # payouts transfer from here; mint only on devnet

# Hyperliquid
HL_API_URL=https://api.hyperliquid-testnet.xyz
HL_CONNECT_TIMEOUT_S=60              # startup only (large one-off metadata downloads), then each client drops to the request timeout
HL_CONNECT_ATTEMPTS=4                # a failed connect step is retried this many times before the service gives up
HL_REQUEST_TIMEOUT_S=15              # per request; without it a stalled connection hangs the caller forever
HL_ACCOUNT_ADDRESS=                  # master account holding margin
HL_API_WALLET_KEY=                   # agent/API wallet private key for that account
HL_MASTER_KEY=                       # DEV ONLY: lets the service move margin to the xyz dex
HL_MM_ACCOUNT_ADDRESS=               # second account for the testnet market maker
HL_MM_API_WALLET_KEY=

# Venue
VENUE=hyperliquid                    # or simulated
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=                        # sent as Authorization: Bearer <key>
PYTH_MOCK_PRICE=                     # dev/tests only
MAX_LEVERAGE=3
MARGIN_BUFFER_PCT=20
MIN_ORDER_USD=10
REBALANCE_BAND_PCT=5
MAX_PRICE_DEVIATION_BPS=200
IOC_MAX_RETRIES=3
ACTIVATION_GRACE_S=120               # a funded deploy that cannot open (no book, price off) retries this long, then fails and refunds
MM_MIN_SIZE=0.02                     # market maker per-level order size bounds (coin units)
MM_MAX_SIZE=0.05
INTENT_TTL_SECONDS=3600
INTENT_TTL_MULTISIG_SECONDS=604800

# Safety
ALLOW_MAINNET=false
DEV_AUTH_BYPASS=false                # DEV ONLY: skips signed-message auth; refused with ALLOW_MAINNET=true; logged on every request

API_KEY=
CORS_ORIGINS=
DATABASE_URL=sqlite:///./service.db
MIGRATE_ON_START=true                # false in production: the API then refuses to start on an out-of-date schema

# --- AI agent (all optional; AGENT_ENABLED=false leaves the service exactly as it was) ---
AGENT_ENABLED=false
AGENT_INTERVAL_S=60                  # 60 for the demo, 300 in production
AGENT_ACT_THRESHOLD=0.80             # act (if delegated) or propose at or above this
AGENT_SUGGEST_THRESHOLD=0.50         # show as a suggestion between the two thresholds
SIGNALS_SOURCE_NETWORK=mainnet       # read-only market signals; execution stays on HL_API_URL (testnet)
SIGNALS_HL_URL=https://api.hyperliquid.xyz   # info reads only: no Exchange, no key
JEV_BASE_URL=https://gateway.ngrok.ai/v1
JEV_API_KEY=                         # ngrok AI Gateway access key (ng-...); never logged
JEV_MODEL=jev-latest
JEV_AUTH_HEADER=auto                 # auto | bearer | x-api-key (auto tries Bearer, then x-api-key on a 401)
JEV_TIMEOUT_S=10
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=800
LLM_TIMEOUT_S=20
CHAT_SESSION_TTL_H=24
CHAT_MAX_MESSAGES=30                 # user messages per chat session
CHAT_MAX_CHARS=4000                  # per message
CHAT_RATE_PER_MIN=12                 # per owner
AGENT_RUN_ONCE_COOLDOWN_S=30         # a second run_once on a strategy inside this returns the latest decision (no Jev/LLM calls)
AGENT_EXEC_CAP_S=600                 # at most one executed agent action per strategy in this window
AGENT_EXEC_MAX_DIVERGENCE_BPS=50     # an action that would execute is only proposed when testnet is further than this from Pyth
